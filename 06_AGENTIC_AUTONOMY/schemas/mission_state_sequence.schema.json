{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission_state_sequence.schema.json",
  "title": "Dynamic Mission State Sequence",
  "type": "object",
  "required": ["schema_version", "mission_id", "snapshots"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "mission_id": {"type": "string", "minLength": 1},
    "snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/snapshot"}}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "sequence", "scenario", "task_lifecycle"],
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "timestamp": {"type": ["string", "null"]},
        "scenario": {"$ref": "mission_scenario.schema.json"},
        "task_lifecycle": {"type": "array", "items": {"$ref": "#/$defs/lifecycle"}}
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["request_id", "state"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["PENDING", "ACTIVE", "COMPLETED", "CANCELLED"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
